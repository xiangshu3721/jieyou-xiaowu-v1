{
  "_metadata": {
    "purpose": "JTBD-05 离线评测虚构场景集",
    "version": "1.0.0",
    "created": "2026-11-24",
    "note": "全部虚构，不含真实用户数据。Mock 固定回复不证明真实 DeepSeek 话术质量。"
  },
  "scenarios": [
    {
      "id": "S01-venting-basic",
      "category": "倾诉",
      "turns": [
        { "role": "user", "content": "最近工作压力很大，每天都觉得很累" }
      ],
      "expected": {
        "user_intent": ["VENTING", "WANTS_COMFORT"],
        "response_goal": ["LISTEN"],
        "no_more_questions": false,
        "must_not": ["CLARIFY_FACT", "PROVIDE_HELP", "ASSESSMENT"]
      },
      "evaluation": {
        "rule_pass": true,
        "experience_pass": "NOT_TESTED",
        "notes": "Mock 不验证自然话术"
      }
    },
    {
      "id": "S02-progress-recognition",
      "category": "进展识别",
      "turns": [
        { "role": "user", "content": "最近总是担心别人的评价" },
        { "role": "assistant", "content": "能多说说吗" },
        { "role": "user", "content": "我好像看清了，原来我一直在担心别人的评价" }
      ],
      "expected": {
        "help_progress": "PROGRESS",
        "must_not_announce": ["问题已解决", "恭喜", "太棒了"]
      },
      "evaluation": {
        "rule_pass": true,
        "experience_pass": "NOT_TESTED"
      }
    },
    {
      "id": "S03-no-help-feedback",
      "category": "无帮助反馈",
      "turns": [
        { "role": "user", "content": "我和伴侣总是吵架" },
        { "role": "assistant", "content": "什么时候开始的" },
        { "role": "user", "content": "好几个月了" },
        { "role": "assistant", "content": "有没有试过沟通" },
        { "role": "user", "content": "你一直问相同的问题，这对我没什么帮助" }
      ],
      "expected": {
        "help_progress": "NO_HELP",
        "routing_change_allowed": true,
        "must_not": ["重复追问", "CLARIFY_FACT"]
      },
      "evaluation": {
        "rule_pass": true,
        "experience_pass": "NOT_TESTED"
      }
    },
    {
      "id": "S04-pause-resume",
      "category": "暂停恢复",
      "turns": [
        { "role": "user", "content": "最近压力很大" },
        { "role": "assistant", "content": "能多说说吗" },
        { "role": "user", "content": "我先安静一会儿" }
      ],
      "expected": {
        "issue_status": "PAUSED",
        "control_intent": "PAUSE_TOPIC",
        "no_more_questions": true,
        "reply_contains": ["随时回来"]
      },
      "resume_turn": {
        "role": "user",
        "content": "我回来继续说压力的事"
      },
      "resume_expected": {
        "issue_status": "ACTIVE",
        "same_issue": true
      },
      "evaluation": {
        "rule_pass": true,
        "experience_pass": "NOT_TESTED"
      }
    },
    {
      "id": "S05-resolve-confirm",
      "category": "明确解决",
      "turns": [
        { "role": "user", "content": "这件事解决了，不用再聊了" }
      ],
      "expected": {
        "issue_status": "CLOSED",
        "control_intent": "RESOLVE_TOPIC",
        "no_more_questions": true,
        "show_booking_button": false,
        "must_not": ["测评推荐", "预约推荐"]
      },
      "evaluation": {
        "rule_pass": true,
        "experience_pass": "NOT_TESTED"
      }
    },
    {
      "id": "S06-resolve-negation",
      "category": "否定解决",
      "turns": [
        { "role": "user", "content": "这件事好像解决了，但其实还没解决" }
      ],
      "expected": {
        "issue_status": "ACTIVE",
        "control_intent_not": "RESOLVE_TOPIC",
        "help_progress": "UNDETERMINED"
      },
      "evaluation": {
        "rule_pass": true,
        "experience_pass": "NOT_TESTED"
      }
    },
    {
      "id": "S07-close-not-resolve",
      "category": "结束≠解决",
      "turns": [
        { "role": "user", "content": "先这样吧，晚安" }
      ],
      "expected": {
        "issue_status": "ACTIVE",
        "control_intent": "CLOSE_TOPIC",
        "reply_length": "SHORT"
      },
      "evaluation": {
        "rule_pass": true,
        "experience_pass": "NOT_TESTED"
      }
    },
    {
      "id": "S08-safety-override",
