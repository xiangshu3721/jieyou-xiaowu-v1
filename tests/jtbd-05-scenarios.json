        { "role": "assistant", "content": "能多说说吗" },
        { "role": "user", "content": "每天都觉得很累，睡不好" },
        { "role": "assistant", "content": "听起来很不容易" },
        { "role": "user", "content": "是啊，但我好像看清了一些，原来我一直在担心别人的评价" },
        { "role": "assistant", "content": "这是你自己看到的变化" },
        { "role": "user", "content": "我知道明天先做什么了" }
      ],
      "final_expected": {
        "help_progress": "PROGRESS",
        "issue_status": "HANDOFF_OFFERED"
      }
    },
    {
      "id": "MT02-pause-resume-resolve",
      "description": "暂停→恢复→解决序列（5轮）",
      "turns": [
        { "role": "user", "content": "我和伴侣最近总吵架" },
        { "role": "assistant", "content": "什么时候开始的" },
        { "role": "user", "content": "好几个月了" },
        { "role": "assistant", "content": "有没有试过沟通" },
        { "role": "user", "content": "我先安静一会儿" },
        { "role": "assistant", "content": "好的，需要的时候随时回来" },
