        "experience_pass": "NOT_TESTED"
      }
    },
    {
      "id": "S16-third-party-not-resolve",
      "category": "第三方引用",
      "turns": [
        { "role": "user", "content": "我朋友的问题解决了但我的没有" }
      ],
      "expected": {
