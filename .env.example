PORT=8787
PROMPT_VERSION=v1.1.0

# DeepSeek：只放在服务端环境，不要提交到前端或 Git。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 飞书多维表格：对应 docs/FEISHU.md 中的字段与权限。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID=
FEISHU_BASE_URL=https://open.feishu.cn

# /dev 内部调试接口口令；至少 12 位。
DEV_TOKEN=

# 只保存预约请求状态、请求编号和飞书 record_id，不保存聊天原文或完整预约内容。
APPOINTMENT_STATE_FILE=./data/appointment-state.json
