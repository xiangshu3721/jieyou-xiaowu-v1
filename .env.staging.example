# Staging deployment is intentionally explicit. Do not copy production values here.
DEPLOY_ENVIRONMENT=staging
DEPLOY_ENV_ID=
DEPLOY_FUNCTION_NAME=jieyou-v19-staging
DEPLOY_SERVICE_PATH=jieyou-v19-staging
DEPLOY_API_DOMAIN=
